
if [ ! -f /sys/class/gpio/gpio12/value ]; then
	echo 12 >/sys/class/gpio/export
	echo out > /sys/class/gpio/gpio12/direction
fi	

echo 0 > /sys/class/gpio/gpio12/value

# Get path to script
dir="$(dirname $0)"

# Set up UART for deserializer configuration
stty -F /dev/ttymxc1 115200 raw evenp cs8

# Disable auto-equalization
echo -en "\x79\x90\x14\x01\x00\x0A" > /dev/ttymxc1
sleep 0.2

#  Set EQ tune to 8.5d
echo -en "\x79\x90\x05\x01\x38\x0A" > /dev/ttymxc1
sleep 0.2

# Enable High immunity mode
echo -en "\x79\x90\x06\x01\xEF\x0A" > /dev/ttymxc1
sleep 0.2

# Use the API test application to put the Probe into bypass mode
$dir/probe-test api-calls SerializerBypassMode 1 10 > /tmp/serializer 2>&1

echo 1 > /sys/class/gpio/gpio12/value

echo both > /sys/class/gpio/mx8_probe_det/edge
echo 1 > /sys/class/gpio/mx8_probe_det/active_low
echo rising > "/sys/class/gpio/SPI Interrupt/edge"
echo rising > /sys/class/gpio/mx8_pic_int3/edge

##This will lead to USB type-C test fail
##echo 1 > /sys/class/gpio/mx8_usbc_pd/active_low

exit 0
