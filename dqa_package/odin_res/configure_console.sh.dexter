#!/bin/bash
# ===========================================
# Odin configure_console.sh (auto GPIO detect)
# ===========================================

# ---------- [GPIO Section] ----------
# Try GPIO12 first, fallback to probe_power_en if not available

# Function to control GPIO12 if it exists
control_gpio12() {
    if [ ! -d /sys/class/gpio/gpio12 ]; then
        echo "Trying to export GPIO12..."
        echo 12 > /sys/class/gpio/export 2>/dev/null
        sleep 0.1
    fi

    if [ -f /sys/class/gpio/gpio12/direction ]; then
        echo "Using /sys/class/gpio/gpio12 for Probe power control"
        echo out > /sys/class/gpio/gpio12/direction
        echo 0 > /sys/class/gpio/gpio12/value
        sleep 0.2
        echo 1 > /sys/class/gpio/gpio12/value
        return 0
    else
        echo "GPIO12 not available or busy"
        return 1
    fi
}

# Function to control probe_power_en if GPIO12 failed
control_probe_power_en() {
    if [ -f /sys/class/gpio/probe_power_en/value ]; then
        echo "Using /sys/class/gpio/probe_power_en for Probe power control"
        echo 0 > /sys/class/gpio/probe_power_en/value
        sleep 0.2
        echo 1 > /sys/class/gpio/probe_power_en/value
        return 0
    else
        echo "probe_power_en not found"
        return 1
    fi
}

# Try both methods
if ! control_gpio12; then
    control_probe_power_en || echo "⚠️  No valid GPIO control found, continuing without power toggle"
fi

# ---------- [UART Configuration Section] ----------
# Get path to script
dir="$(dirname $0)"

# Set up UART for deserializer configuration
stty -F /dev/ttymxc1 115200 raw evenp cs8

# Disable auto-equalization
echo -en "\x79\x90\x14\x01\x00\x0A" > /dev/ttymxc1
sleep 0.2

# Set EQ tune to 8.5d
echo -en "\x79\x90\x05\x01\x38\x0A" > /dev/ttymxc1
sleep 0.2

# Enable High immunity mode
echo -en "\x79\x90\x06\x01\xEF\x0A" > /dev/ttymxc1
sleep 0.2

# ---------- [Serializer Bypass Mode Section] ----------
if [ -x "$dir/probe-test" ]; then
    echo "Running SerializerBypassMode..."
    $dir/probe-test api-calls SerializerBypassMode 1 10 > /tmp/serializer 2>&1
else
    echo "⚠️  probe-test not found or not executable"
fi

# ---------- [GPIO interrupt setup Section] ----------
if [ -f /sys/class/gpio/mx8_probe_det/edge ]; then
    echo both > /sys/class/gpio/mx8_probe_det/edge
    echo 1 > /sys/class/gpio/mx8_probe_det/active_low
fi

if [ -f "/sys/class/gpio/SPI Interrupt/edge" ]; then
    echo rising > "/sys/class/gpio/SPI Interrupt/edge"
fi

if [ -f /sys/class/gpio/mx8_pic_int3/edge ]; then
    echo rising > /sys/class/gpio/mx8_pic_int3/edge
fi

# Note: mx8_usbc_pd left untouched due to USB-C test side effects
# echo 1 > /sys/class/gpio/mx8_usbc_pd/active_low

echo "Configuration complete!"
exit 0

