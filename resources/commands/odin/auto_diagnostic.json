{
  "diagnostic_cpu_name": {
    "commands": [
      "cat /sys/devices/soc0/soc_id"
    ],
    "expected_response": [
      "i.MX8MQ"
    ]
  },
  "diagnostic_cpu_processor": {
    "commands": [
      "grep -c ^processor /proc/cpuinfo"
    ],
    "expected_response": [
      "4"
    ]
  },
  "diagnostic_emmc_size": {
    "commands": [
      "cat /sys/block/mmcblk0/size"
    ],
    "expected_response": [
      "61120512"
    ]
  },
  "diagnostic_mac_address": {
    "commands": [
      "cat /sys/class/net/eth0/address"
    ],
    "expected_response": [
      ""
    ]
  },
  "diagnostic_memory_size": {
    "commands": [
      "grep MemTotal /proc/meminfo"
    ],
    "expected_response": [
      "3074232"
    ]
  },
  "diagnostic_nor_flash_size": {
    "commands": [
      "cat /proc/mtd | grep mtd0"
    ],
    "expected_response": [
      "04000000"
    ]
  },
  "diagnostic_pic_version": {
    "commands": [
      "i2ctransfer -f -y 2 w4@0x4c 0x03 0x21 0x00 0x10 r1; sleep 0.1; i2ctransfer -f -y 2 w4@0x4c 0x03 0x23 0x00 0x10 r2"
    ],
    "expected_response": [
      "0x18"
    ]
  },
  "diagnostic_model": {
    "commands": [
      "cat /proc/device-tree/model"
    ],
    "expected_response": [
      "PSC Odin"
    ]
  },
  "diagnostic_design_capacity": {
    "commands": [
      "i2ctransfer -f -y 2 w4@0x4c 0x03 0x51 0x00 0x18 r1; sleep 0.1; i2ctransfer -f -y 2 w4@0x4c 0x03 0x53 0x00 0x18 r2"
    ],
    "expected_response": [
      "0x1a 0x90"
    ]
  },
  "diagnostic_design_voltage": {
    "commands": [
      "i2ctransfer -f -y 2 w4@0x4c 0x03 0x51 0x00 0x19 r1; sleep 0.1; i2ctransfer -f -y 2 w4@0x4c 0x03 0x53 0x00 0x19 r2"
    ],
    "expected_response": [
      "0x2a 0xc6"
    ]
  },
  "diagnostic_uboot_version": {
    "commands": [
      "dd if=/dev/mmcblk0boot0 bs=1M count=4 2>/dev/null | strings | grep \"U-Boot\" | grep -v \"SPL\" | tail -1"
    ],
    "expected_response": [
      "U-Boot"
    ]
  },
  "diagnostic_kernal_name": {
    "commands": [
      "uname -a"
    ],
    "expected_response": [
      "Linux odin"
    ]
  },
  "diagnostic_panel_id": {
    "commands": [
      "cat /proc/panel_id"
    ],
    "expected_response": [
      "01"
    ]
  },
  "diagnostic_panel_resolution": {
    "commands": [
      "fbset | grep geometry"
    ],
    "expected_response": [
      "1280 800"
    ]
  },
  "diagnostic_wifi_module": {
    "commands": [
      "lsusb"
    ],
    "expected_response": [
      "1286:204e"
    ]
  },
  "diagnostic_bt_module": {
    "commands": [
      "lspci"
    ],
    "expected_response": [
      "Marvell"
    ]
  }
}