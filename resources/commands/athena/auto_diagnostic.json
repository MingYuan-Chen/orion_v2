{
  "diagnostic_cpu_name": {
    "commands": [
      "lscpu | grep 'Model name'"
    ],
    "expected_response": [
      "Cortex-A53"
    ]
  },
  "diagnostic_cpu_processor": {
    "commands": [
      "grep -c ^processor /proc/cpuinfo"
    ],
    "expected_response": [
      "4"
    ]
  },
  "diagnostic_emmc_size": {
    "commands": [
      "cat /sys/block/mmcblk0/size"
    ],
    "expected_response": [
      "244285440"
    ]
  },
  "diagnostic_mac_address": {
    "commands": [
      "cat /sys/class/net/eth0/address"
    ],
    "expected_response": [
      ""
    ]
  },
  "diagnostic_memory_size": {
    "commands": [
      "grep MemTotal /proc/meminfo"
    ],
    "expected_response": [
      "3943740"
    ]
  },
  "diagnostic_pic_version": {
    "commands": [
      "i2ctransfer -f -y 1 w4@0x4c 0x03 0x21 0x00 0x10 r1; sleep 0.1; i2ctransfer -f -y 1 w4@0x4c 0x03 0x23 0x00 0x10 r2"
    ],
    "expected_response": [
      "0x08",
      "0x09",
      "0x0a",
      "0x0b"
    ]
  },
  "diagnostic_model": {
    "commands": [
      "cat /proc/device-tree/model"
    ],
    "expected_response": [
      "Athena-030"
    ]
  },
  "diagnostic_sync_time": {
    "commands": [
      "date -s '2024-02-28 23:59:59'",
      "hwclock -r",
      "date"
    ],
    "validate_function": "validate_sync_time_for_athena"
  },
  "diagnostic_design_capacity": {
    "commands": [
      "i2ctransfer -f -y 1 w4@0x4c 0x03 0x51 0x00 0x18 r1; sleep 0.1; i2ctransfer -f -y 1 w4@0x4c 0x03 0x53 0x00 0x18 r2"
    ],
    "expected_response": [
      "0x0c 0xb2"
    ]
  },
  "diagnostic_design_voltage": {
    "commands": [
      "i2ctransfer -f -y 1 w4@0x4c 0x03 0x51 0x00 0x19 r1; sleep 0.1; i2ctransfer -f -y 1 w4@0x4c 0x03 0x53 0x00 0x19 r2"
    ],
    "expected_response": [
      "0x2a 0x30"
    ]
  },
  "diagnostic_uboot_version": {
    "commands": [
      "strings /dev/mtd5 | grep -E 'U-Boot'"
    ],
    "expected_response": [
      "U-Boot 2023.01 (Aug 27 2025 - 13:59:49 +0000)"
    ]
  },
  "diagnostic_kernal_name": {
    "commands": [
      "uname -a"
    ],
    "expected_response": [
      "Linux verathon-athena"
    ]
  },
  "diagnostic_panel_resolution": {
    "commands": [
      "fbset | grep geometry"
    ],
    "expected_response": [
      "1920 1080"
    ]
  },
  "diagnostic_wifi_module": {
    "commands": [
      "lsusb"
    ],
    "expected_response": [
      "1286:204e"
    ]
  },
  "diagnostic_bt_module": {
    "commands": [
      "lspci"
    ],
    "expected_response": [
      "Marvell"
    ]
  },
  "diagnostic_ethernet_connection": {
    "commands": [
      "nmcli device disconnect wlp1s0",
      "curl -I -s https://www.google.com | grep HTTP/",
      "nmcli device connect wlp1s0"
    ],
    "expected_response": [
      "HTTP/1.1 200 OK"
    ]
  },
  "diagnostic_wifi_connection": {
    "commands": [
      "nmcli device wifi rescan",
      "nmcli device wifi connect DQA-Mesh66 password PromateDQA2025",
      "nmcli connection modify DQA-Mesh66 ipv4.route-metric 50",
      "nmcli connection up DQA-Mesh66",
      "curl -I -s https://www.google.com | grep HTTP/",
      "nmcli connection modify DQA-Mesh66 ipv4.route-metric 600",
      "nmcli connection up DQA-Mesh66"
    ],
    "expected_response": [
      "HTTP/1.1 200 OK"
    ]
  }
}