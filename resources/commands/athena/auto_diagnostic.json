{
  "diagnostic_cpu_name": {
    "commands": ["lscpu | grep 'Model name'"],
    "expected_response": ["Cortex-A53"]
  },
  "diagnostic_cpu_processor": {
    "commands": ["grep -c ^processor /proc/cpuinfo"],
    "expected_response": ["4"]
  },
  "diagnostic_emmc_size": {
    "commands": ["cat /sys/block/mmcblk0/size"],
    "expected_response": ["244285440"]
  },
  "diagnostic_mac_address": {
    "commands": ["cat /sys/class/net/eth0/address"]
  },
  "diagnostic_memory_size": {
    "commands": ["grep MemTotal /proc/meminfo"],
    "expected_response": ["3943740"]
  },
  "diagnostic_nor_flash_size": {
    "commands": ["cat /proc/mtd | grep 'mtd0"],
    "expected_response": ["04000000"],
    "ignore_commands": ["True"]
  },
  "diagnostic_pic_version": {
    "commands": ["i2ctransfer -f -y 1 w4@0x4c 0x03 0x21 0x00 0x10 r1; sleep 0.1; i2ctransfer -f -y 1 w4@0x4c 0x03 0x23 0x00 0x10 r2", "cat /proc/device-tree/model"],
    "expected_response": ["0x08", "Athena-030"]
  },
  "diagnostic_sync_time": {
    "commands": ["date -s '2024-02-28 23:59:59'", "hwclock -r", "date"]
  },
  "diagnostic_set_get_rtc_time": {
    "commands": ["date -s '2024-02-28 23:59:59'", "hwclock -w", "hwclock -r"],
    "expected_response": ["Wed Feb 28 23:59:59 UTC 2024", "", "2024-02-29"]
  },
  "diagnostic_design_capacity": {
    "commands": ["i2ctransfer -f -y 1 w4@0x4c 0x03 0x51 0x00 0x18 r1; sleep 0.1; i2ctransfer -f -y 1 w4@0x4c 0x03 0x53 0x00 0x18 r2"],
    "expected_response": ["0x0c 0xb2"]
  },
  "diagnostic_design_voltage": {
    "commands": ["i2ctransfer -f -y 1 w4@0x4c 0x03 0x51 0x00 0x19 r1; sleep 0.1; i2ctransfer -f -y 1 w4@0x4c 0x03 0x53 0x00 0x19 r2"],
    "expected_response": ["0x2a 0x30"]
  },
  "diagnostic_uboot_version": {
    "commands": ["strings /dev/mtd5 | grep -E 'U-Boot'"]
  },
  "diagnostic_kernal_name": {
    "commands": ["uname -a"],
    "expected_response": ["Linux verathon-athena"]
  },
  "diagnostic_panel_id_resolution": {
    "commands": ["fbset | grep geometry", "cat /proc/panel_id"],
    "expected_response": ["", "01"],
    "ignore_commands": ["False", "True"]
  },
  "diagnostic_wifi_bt": {
    "commands": ["lsusb", "lspci"],
    "expected_response": ["1286:204e", "Marvell"]
  },
  "diagnostic_ethernet": {
    "commands": ["nmcli device disconnect wlp1s0", "curl -I -s https://www.google.com | grep 'HTTP/"],
    "expected_response": ["", "HTTP/1.1 200 OK"]
  },
  "diagnostic_wifi_connection": {
    "commands": ["nmcli device disconnect eth0", "nmcli device wifi rescan", "nmcli device wifi connect DQA-Mesh66 password PromateDQA2025", "curl -I -s https://www.google.com | grep 'HTTP/"],
    "expected_response": ["", "", "", "HTTP/1.1 200 OK"]
  }
}