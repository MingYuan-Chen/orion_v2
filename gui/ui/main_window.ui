  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background-color: #2D2D30;
    color: white;
}

QLabel {
    color: white;
}

QPushButton {
    background-color: #0078D7;
    color: white;
    border: none;
    padding: 5px 15px;
    border-radius: 2px;
}

QPushButton:hover {
    background-color: #1C97EA;
}

QPushButton:pressed {
    background-color: #00559F;
}

QPushButton.edit-button {
    background-color: #444444;
    padding: 2px 5px;
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
    border-radius: 3px;
}

QPushButton.edit-button:hover {
    background-color: #555555;
}

QPushButton.edit-button:pressed {
    background-color: #666666;
}

QGroupBox {
    color: white;
    border: 1px solid #3F3F46;
    border-radius: 3px;
    margin-top: 10px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 3px 0 3px;
}

QProgressBar {
    border: 1px solid #3F3F46;
    border-radius: 2px;
    text-align: center;
    background-color: #252526;
}

QProgressBar::chunk {
    background-color: #0078D7;
}

QTableWidget {
    background-color: #252526;
    alternate-background-color: #2D2D30;
    color: white;
    border: 1px solid #3F3F46;
    gridline-color: #3F3F46;
}

QTableWidget QHeaderView::section {
    background-color: #333337;
    color: white;
    padding: 5px;
    border: 1px solid #3F3F46;
}

QTabWidget::pane {
    border: 1px solid #3F3F46;
    background-color: #252526;
}

QTabBar::tab {
    background-color: #2D2D30;
    color: white;
    padding: 8px 15px;
    border: 1px solid #3F3F46;
    border-bottom: none;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
}

QTabBar::tab:selected {
    background-color: #0078D7;
}

QTabBar::tab:!selected {
    margin-top: 2px;
}

/* 新增样式 */
QFrame.info-panel {
    background-color: #2E2E2E;
    border: 1px solid #3E3E3E;
    border-radius: 5px;
}

QLabel.panel-value {
    color: #4FC3F7;
}

QLabel.initializing {
    color: #888888;
    font-style: italic;
}
</string>
