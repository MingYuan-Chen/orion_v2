          <property name="styleSheet">
           <string notr="true">QTableWidget {
  background-color: #1E1E1E;
  color: white;
  gridline-color: #333333;
}

QTableWidget::item:selected {
  background-color: #3F3F46;
}

/* InfoRow 背景色 */
QTableWidget::item[LogLevel=&quot;INFO&quot;] {
  background-color: transparent;
}

QTableWidget::item[LogLevel=&quot;INFO&quot;]::text {
  color: #3794FF;
}

/* WarningRow 背景色 */
QTableWidget::item[LogLevel=&quot;WARNING&quot;] {
  background-color: transparent;
}

QTableWidget::item[LogLevel=&quot;WARNING&quot;]::text {
  color: #FFD700;
}

/* ErrorRow 背景色 */
QTableWidget::item[LogLevel=&quot;ERROR&quot;] {
  background-color: transparent;
}

QTableWidget::item[LogLevel=&quot;ERROR&quot;]::text {
  color: #FF3333;
}

/* DebugRow 背景色 */
QTableWidget::item[LogLevel=&quot;DEBUG&quot;] {
  background-color: transparent;
}

QTableWidget::item[LogLevel=&quot;DEBUG&quot;]::text {
  color: #888888;
}</string>
